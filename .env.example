# ==========================================
# UPIQ 2.0 - Environment Configuration
# ==========================================

# ------------------------------------------
# PostgreSQL Database
# ------------------------------------------
POSTGRES_DB=upiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upiq
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/upiq

# ------------------------------------------
# Backend Service (Spring Boot)
# ------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# Use at least 32 UTF-8 bytes of randomly generated key material in production. Never use this placeholder.
JWT_SECRET=replace_with_unique_random_key_material_of_at_least_32_bytes
JWT_EXPIRATION=86400000

# ------------------------------------------
# Local Ollama (Docker Compose backend)
# ------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT=60s

# ------------------------------------------
# Frontend Service (React / Vite)
# ------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
