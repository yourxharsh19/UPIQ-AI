# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upiq
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/upiq

# Server Port
SERVER_PORT=8080

# Spring Active Profile (local / prod / research)
SPRING_PROFILES_ACTIVE=local

# Security & JWT
# Use at least 32 UTF-8 bytes of randomly generated key material in production. Never use this placeholder.
JWT_SECRET=replace_with_unique_random_key_material_of_at_least_32_bytes
JWT_EXPIRATION=86400000
